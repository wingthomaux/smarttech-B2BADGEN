{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node scripts/check-internal-links.mjs && node --test tests/*.test.mjs",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "project:status": "node scripts/check-collaboration.mjs",
    "source:candidates:check": "node scripts/check-source-candidates.mjs",
    "source:weka": "node scripts/sync-weka-downloads.mjs",
    "source:weka:baseline": "node scripts/sync-weka-downloads.mjs --baseline",
    "source:silicon": "node scripts/import-silicon-resources-20260915.mjs",
    "source:telecom-handel": "node scripts/review-telecom-handel-source.mjs",
    "translate:silicon": "node scripts/add-silicon-english-translations-20260915.mjs",
    "translate:serviceware": "node scripts/add-serviceware-english-translations-20260916.mjs",
    "translate:mnet": "node scripts/add-mnet-english-translations-20260916.mjs",
    "translate:akamai": "node scripts/add-akamai-english-translations-20260917.mjs",
    "translate:telecom-handel": "node scripts/add-telecom-handel-english-translations-20260917.mjs",
    "translate:servicenow": "node scripts/add-servicenow-english-translations-20260921.mjs",
    "translate:telecom-wave1": "node scripts/add-telecom-wave1-english-translations-20260921.mjs",
    "translate:telecom-wave2": "node scripts/add-telecom-wave2-english-translations-20260922.mjs",
    "translate:weka": "node scripts/add-weka-english-translations-20260916.mjs",
    "translate:en": "python scripts/generate-english-translations.py",
    "release:check": "node scripts/check-collaboration.mjs --release",
    "verify": "npm run lint && npm run source:candidates:check && npm test",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
